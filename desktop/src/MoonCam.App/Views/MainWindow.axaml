<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoonCam.App.ViewModels"
        xmlns:setup="using:MoonCam.Core.Setup"
        x:Class="MoonCam.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1080" Height="700" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="{StaticResource NightGradient}"
        Foreground="{StaticResource TextBrush}"
        Icon="avares://mooncam/Assets/mooncam.png"
        Title="MoonCam">

    <!-- macOS-style window: a full-width title bar (drag to move, double-click to zoom), a floating glass
         sidebar and the live preview. Edges stay grabbable for resizing (see MainWindow.axaml.cs). -->
    <Grid RowDefinitions="44,*">

        <!-- ===== Title bar: the whole strip moves the window ===== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" ColumnDefinitions="90,*,90">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="20,0,0,0">
                <Button x:Name="CloseButton" Classes="light close" ToolTip.Tip="Close" />
                <Button x:Name="MinimizeButton" Classes="light minimize" ToolTip.Tip="Minimise" />
                <Button x:Name="ZoomButton" Classes="light zoom" ToolTip.Tip="Zoom" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                        VerticalAlignment="Center" IsHitTestVisible="False">
                <Image Source="avares://mooncam/Assets/mooncam.png" Width="18" Height="18" />
                <TextBlock Text="MoonCam" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="·" Classes="muted" FontSize="13" />
                <TextBlock Text="{Binding StatusTitle}" Classes="muted" FontSize="13" />
            </StackPanel>
        </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="300,*">

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Classes="glass" Margin="10,0,10,10" Padding="16,14" CornerRadius="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
                    <Image Source="avares://mooncam/Assets/mooncam.png" Width="44" Height="44" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MoonCam" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="by Moon Technologies" Classes="muted" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Classes="muted mono" FontSize="10.5" Opacity="0.7"
                           Text="Local only · no cloud · no telemetry" Margin="4,12,0,0" />

                <ScrollViewer>
                    <StackPanel>
                        <!-- Setup assistant: shown until everything MoonCam needs is installed -->
                        <StackPanel IsVisible="{Binding !IsSetupComplete}">
                            <TextBlock Classes="section" Text="REPAIR SETUP" />
                            <Border Classes="glass">
                                <StackPanel Spacing="8">
                                    <ItemsControl ItemsSource="{Binding SetupItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="setup:Component">
                                                <Grid ColumnDefinitions="18,*" Margin="0,0,0,6">
                                                    <TextBlock Text="✓" Foreground="{StaticResource OkBrush}" IsVisible="{Binding IsReady}" />
                                                    <TextBlock Text="•" Foreground="{StaticResource GlowBrush}" IsVisible="{Binding !IsReady}" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" />
                                                        <TextBlock Text="{Binding Purpose}" Classes="muted" FontSize="11.5" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Classes="primary" Content="Install" Command="{Binding InstallComponentsCommand}"
                                            IsEnabled="{Binding !IsInstalling}" />
                                    <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"
                                               Text="Ubuntu asks for your password in its own window. MoonCam never sees it." />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Classes="section" Text="PHONE" />
                        <Border Classes="glass">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource LiveBrush}" IsVisible="{Binding IsLive}" />
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource FaintBrush}" IsVisible="{Binding !IsLive}" />
                                    <TextBlock Text="{Binding StatusTitle}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding PhoneName}" Classes="muted" FontSize="12.5" />
                            </StackPanel>
                        </Border>
                        <Button Classes="primary" Margin="0,10,0,0" Content="Connect via USB" Command="{Binding ConnectUsbCommand}" />
                        <Button Classes="ghost" Margin="0,8,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                Content="Pair over Wi-Fi" Command="{Binding PairOverWiFiCommand}"
                                IsVisible="{Binding IsWiFiAvailable}" />
                        <TextBlock Classes="muted" FontSize="11.5" Margin="4,8,4,0" TextWrapping="Wrap" Text="{Binding WiFiStatus}"
                                   IsVisible="{Binding WiFiStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Phones allowed over Wi-Fi -->
                        <StackPanel IsVisible="{Binding HasPairedPhones}">
                            <TextBlock Classes="section" Text="PAIRED PHONES" />
                            <ItemsControl ItemsSource="{Binding PairedPhones}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PairedPhoneOption">
                                        <Border Classes="glass" Margin="0,0,0,6" Padding="12,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" />
                                                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="ghost" Content="Remove" FontSize="11.5" VerticalAlignment="Center"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).RemovePairedPhoneCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Networks where Wi-Fi is allowed -->
                        <StackPanel IsVisible="{Binding HasTrustedNetworks}">
                            <TextBlock Classes="section" Text="TRUSTED NETWORKS" />
                            <ItemsControl ItemsSource="{Binding TrustedNetworks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TrustedNetworkOption">
                                        <Border Classes="glass" Margin="0,0,0,6" Padding="12,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Classes="ghost" Content="Forget" FontSize="11.5" VerticalAlignment="Center"
                                                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ForgetNetworkCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Classes="section" Text="CAMERA" />
                        <ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CameraOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox Margin="0,8,0,0" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:PresetOption">
                                    <TextBlock Text="{Binding Label}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Classes="muted" FontSize="12" Text="Quality" Margin="4,10,0,4" />
                        <ComboBox ItemsSource="{Binding Qualities}" SelectedIndex="{Binding SelectedQuality}" />

                        <TextBlock Classes="section" Text="VIRTUAL CAMERA" />
                        <Border Classes="glass">
                            <StackPanel Spacing="6">
                                <ToggleSwitch Content="Use as webcam" IsChecked="{Binding IsVirtualCameraOn}"
                                              IsEnabled="{Binding IsVirtualCameraAvailable}" />
                                <TextBlock Text="{Binding VirtualCameraStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== Preview ===== -->
        <Grid Grid.Column="1" Margin="0,0,10,10" RowDefinitions="*,Auto">
            <Border x:Name="PreviewFrame" CornerRadius="22" ClipToBounds="True" Background="#0A0D24"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" IsVisible="{Binding IsLive}" />

                    <!-- Waiting state: covers the whole preview, so no stale picture shows through -->
                    <Grid IsVisible="{Binding !IsLive}" Background="#0A0D24">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="420" Margin="24">
                        <Image Source="avares://mooncam/Assets/mooncam.png" Width="96" Height="96" Opacity="0.9" />
                        <TextBlock Classes="title" HorizontalAlignment="Center" Text="{Binding StatusTitle}" />
                        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="{Binding StatusDetail}" />
                        <Border Classes="glass" Margin="0,12,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="1  Enable USB debugging in Developer options" Classes="muted" FontSize="12.5" />
                                <TextBlock Text="2  Connect the phone with a USB cable" Classes="muted" FontSize="12.5" />
                                <TextBlock Text="3  Press Connect via USB and allow MoonCam on the phone" Classes="muted" FontSize="12.5" TextWrapping="Wrap" />
                                <TextBlock Text="Or pair once over Wi-Fi: after that the phone connects by itself." Classes="muted" FontSize="12" Opacity="0.85" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>

                    <!-- Wi-Fi pairing: front and centre, the code is the one thing the user must look at -->
                    <Grid IsVisible="{Binding IsPairingOpen}" Background="#0A0D24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460" Margin="24">
                            <Image Source="avares://mooncam/Assets/mooncam.png" Width="72" Height="72" />
                            <StackPanel IsVisible="{Binding PairingCode, Converter={x:Static ObjectConverters.IsNull}}" Spacing="8">
                                <TextBlock Classes="title" HorizontalAlignment="Center" Text="Pair over Wi-Fi" />
                                <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                           Text="On your phone, open MoonCam and choose this computer. Both must be on the same Wi-Fi network." />
                                <TextBlock Classes="mono muted" HorizontalAlignment="Center" FontSize="13" Text="{Binding PairingCountdown}" />
                            </StackPanel>
                            <StackPanel IsVisible="{Binding PairingCode, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="8">
                                <TextBlock Classes="title" HorizontalAlignment="Center" Text="Does your phone show this code?" />
                                <TextBlock Classes="muted" HorizontalAlignment="Center" Text="{Binding PairingPhone}" />
                                <TextBlock Classes="mono" FontSize="56" FontWeight="Medium" LetterSpacing="4" HorizontalAlignment="Center"
                                           Foreground="{StaticResource GlowBrush}" Text="{Binding PairingCode}" Margin="0,8" />
                                <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12"
                                           Text="Pair only if the six digits are exactly the same on both screens." />
                                <Button Classes="primary" HorizontalAlignment="Center" MinWidth="220" Margin="0,6,0,0"
                                        Content="Codes match — Pair" Command="{Binding ApprovePairingCommand}" />
                            </StackPanel>
                            <Button Classes="ghost" HorizontalAlignment="Center" HorizontalContentAlignment="Center" MinWidth="120" Content="Cancel" Command="{Binding CancelPairingCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Trusting a network: asked once per network, before Wi-Fi is used on it -->
                    <Grid IsVisible="{Binding IsTrustPromptOpen}" Background="#0A0D24">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="460" Margin="24">
                            <Image Source="avares://mooncam/Assets/mooncam.png" Width="72" Height="72" />
                            <TextBlock Classes="title" HorizontalAlignment="Center" Text="Is this your network?" />
                            <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource GlowBrush}" Text="{Binding TrustPromptNetwork}" />
                            <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                       Text="MoonCam uses Wi-Fi only on networks you trust, like your home or office. On public networks (cafés, airports, hotels) it stays off and invisible; the USB cable always works." />
                            <Button Classes="primary" HorizontalAlignment="Center" MinWidth="240" Margin="0,6,0,0"
                                    Content="Yes, it's mine — Pair" Command="{Binding TrustNetworkAndPairCommand}" />
                            <Button Classes="ghost" HorizontalAlignment="Center" HorizontalContentAlignment="Center" MinWidth="120" Content="Cancel" Command="{Binding CancelTrustCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- LIVE badge -->
                    <Border IsVisible="{Binding IsLive}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                            Background="#CC0B1026" CornerRadius="999" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource LiveBrush}" />
                            <TextBlock Text="LIVE" Classes="mono" FontSize="11" FontWeight="Medium" LetterSpacing="1.5" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Status bar: stats and notices -->
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="6,10,6,0">
                <TextBlock Text="{Binding Notice}" Classes="muted" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding StatsText}" Classes="muted mono" FontSize="12" />
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</Window>
